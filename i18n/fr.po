msgctxt "UI_TOOLS_REPORT"
msgid "Report a problem"
msgstr "Signaler un problème"

#. Under Report a problem.
msgctxt "UI_TOOLS_REPORT_NOTE"
msgid "Copies your system's details and opens the bug report form, to paste them in"
msgstr "Copie les détails de votre système et ouvre le formulaire de bug pour les coller"

#. Button of Report a problem.
msgctxt "UI_TOOLS_REPORT_BUTTON"
msgid "Report"
msgstr "Signaler"

#. After Report.
msgctxt "UI_TOOLS_REPORT_COPIED"
msgid "Your system's details are on the clipboard: paste them in the form"
msgstr "Les détails de votre système sont dans le presse-papiers : collez-les dans le formulaire"

#. Tools page row with the log folder's button.
msgctxt "UI_TOOLS_LOGS"
msgid "Logs"
msgstr "Journaux"

#. A Tools page action that did not work: %s says why.
#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_TOOLS_FAILED"
msgid "Failed: %s"
msgstr "Échec : %s"

msgctxt "UI_LAUNCH_NO_GAME_DATA"
